+    await ctx.route('https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js', r => r.fulfill({ status: 200, headers: { ...CORS, 'content-type': 'text/javascript' }, body: `export * from 'https://fb.test/shared.js';
