{
  "appId": "app.manaorbit",
  "appName": "Mana Orbit",
  "webDir": "www",
  "server": {
    "url": "https://manaorbit.app",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "index.html",
    "allowNavigation": [
      "card.m2s-photo.fr"
    ]
  },
  "android": {
    "backgroundColor": "#0b0f1c"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
